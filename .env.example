# Public frontend configuration used by the Vercel build
VITE_USERS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_USERS_DEPLOYMENT_ID/exec
VITE_SALES_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SALES_DEPLOYMENT_ID/exec
VITE_PRODUCT_SHEET_URL=https://script.google.com/macros/s/YOUR_PRODUCTS_DEPLOYMENT_ID/exec?type=products
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID.apps.googleusercontent.com

# Optional Cloudinary upload settings for admin media uploads
# VITE_CLOUDINARY_CLOUD_NAME=
# VITE_CLOUDINARY_UPLOAD_PRESET=

# Server-only Shiprocket settings. Put real values in .env.local, never VITE_* variables.
SHIPROCKET_EMAIL=your-shiprocket-email
SHIPROCKET_PASSWORD=your-shiprocket-password
SHIPROCKET_PICKUP_LOCATION=Primary
